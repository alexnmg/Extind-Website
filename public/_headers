# Cloudflare Workers Static Assets reads this file from the assets directory.
# Vite copies public/ verbatim into dist/, so it lands where Cloudflare expects.

/*
  # Stops a browser second-guessing a declared content type. Matters here because
  # the SPA fallback answers unknown paths with HTML at a 200.
  X-Content-Type-Options: nosniff
  # Send the origin, never the full path, to other sites. Keeps the page someone
  # was reading out of third-party logs.
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing on this site needs any of these.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  # Origins below are the ones the site actually loads from, verified against the
  # live pages — OpenFreeMap for the contact-page map, Cal.com for the booking
  # embed and its iframe. Fonts are self-hosted, so no font origin is allowed. 'unsafe-inline' is
  # needed for style only: React style attributes and MapLibre both inject them.
  # Scripts carry no such exception. frame-ancestors replaces X-Frame-Options and
  # is what stops the contact form and booker being framed by anyone else.
  #
  # The map needs three of these entries, and misses fail silently as a blank
  # box: connect-src for the style JSON, vector tiles, glyphs and sprite sheet;
  # img-src for the sprite image and the Natural Earth raster underlay; and
  # worker-src blob:, because MapLibre builds its tile workers from a blob URL —
  # without it the workers are blocked and nothing ever renders.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://app.cal.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://app.cal.com https://tiles.openfreemap.org; frame-src https://app.cal.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Vite fingerprints these filenames, so the content at a given URL never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Font files never change without a filename change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Width and format are in the filename, so a given URL's bytes never change.
/photos/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned by filename (-v1), same reasoning.
/og/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=604800

# HTML must revalidate, or a deploy never reaches anyone holding a cached copy.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
